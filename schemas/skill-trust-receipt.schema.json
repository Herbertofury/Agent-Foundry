{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Herbertofury/Agent-Foundry/raw/main/schemas/skill-trust-receipt.schema.json",
  "title": "Agent Foundry Skill Trust Receipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "skill",
    "source",
    "sourceRevision",
    "digest",
    "reviewedAt",
    "trustState"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "formatValid": {
      "type": "boolean"
    },
    "scannerEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "result"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "type": "string"
          },
          "report": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "filesystem-read",
          "filesystem-write",
          "network",
          "subprocess",
          "credentials",
          "connectors",
          "external-side-effects",
          "other"
        ]
      },
      "uniqueItems": true
    },
    "manualReview": {
      "type": [
        "string",
        "null"
      ]
    },
    "sandboxEval": {
      "type": [
        "string",
        "null"
      ]
    },
    "trustState": {
      "enum": [
        "quarantined",
        "reviewed",
        "trusted-pinned",
        "rejected",
        "unresolved"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
