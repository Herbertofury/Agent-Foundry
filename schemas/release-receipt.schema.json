{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Herbertofury/Agent-Foundry/raw/main/schemas/release-receipt.schema.json",
  "title": "Agent Foundry Release Receipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifact",
    "source",
    "sourceRevision",
    "sha256",
    "sizeBytes",
    "builtAt",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifact": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0
    },
    "builtAt": {
      "type": "string",
      "format": "date-time"
    },
    "workflow": {
      "type": [
        "string",
        "null"
      ]
    },
    "attestation": {
      "type": [
        "string",
        "null"
      ]
    },
    "sbom": {
      "type": [
        "string",
        "null"
      ]
    },
    "agBOM": {
      "type": [
        "string",
        "null"
      ]
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
