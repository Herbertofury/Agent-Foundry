{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Herbertofury/Agent-Foundry/raw/main/schemas/eval-case.schema.json",
  "title": "Agent Foundry Eval Case",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "task",
    "shouldTrigger",
    "assertions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "shouldTrigger": {
      "type": "boolean"
    },
    "sideEffectLevel": {
      "enum": [
        "static",
        "local-only",
        "live-safe",
        "live-external"
      ]
    },
    "workspaceFixture": {
      "type": [
        "string",
        "null"
      ]
    },
    "protectedInvariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "expectation"
        ],
        "properties": {
          "type": {
            "enum": [
              "file",
              "git",
              "json",
              "log",
              "exit",
              "runtime",
              "llm-rubric",
              "custom"
            ]
          },
          "expectation": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "cleanup": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
