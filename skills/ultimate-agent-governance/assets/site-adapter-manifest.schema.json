{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/site-adapter-manifest.schema.json",
  "title": "Site Adapter Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "version", "base_urls", "capabilities", "auth", "transports", "pagination", "health"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "base_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "auth": {
      "type": "object",
      "required": ["methods", "required_for"],
      "properties": {
        "methods": {"type": "array", "uniqueItems": true, "items": {"enum": ["none", "oauth2", "device-code", "api-token", "browser-session"]}},
        "required_for": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "transports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["official-api", "public-endpoint", "structured-endpoint", "embedded-structured-data", "html", "authorized-browser-session"]}
    },
    "pagination": {
      "type": "object",
      "required": ["modes"],
      "properties": {
        "modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["none", "page", "offset", "cursor", "next-link", "infinite-scroll"]}}
      }
    },
    "health": {
      "type": "object",
      "required": ["supported"],
      "properties": {"supported": {"type": "boolean"}}
    }
  }
}
