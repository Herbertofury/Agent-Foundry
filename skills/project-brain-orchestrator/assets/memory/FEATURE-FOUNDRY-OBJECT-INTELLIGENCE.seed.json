  "purpose": "Reversible, provenance-preserving conversion of still images, animated media, 3D files and Blender scenes into editable Feature Foundry objects.",
  "quality_lanes": [
    {
      "id": "instant-preview",
      "latency_target": "interactive seconds",
      "purpose": "Produce a truthful cutout, animated sticker, layered card or rough proxy immediately without pretending it is finished 3D.",
      "may_use": [
        "segmentation",
        "alpha cleanup",
        "depth layers",
        "billboard proxy",
        "simple collider"
      ],
      "promotion_gate": "User can inspect uncertainty and request a better lane."
    },
    {
      "id": "interactive-draft",
      "latency_target": "bounded background job",
      "purpose": "Create editable parts, depth/material hints, collision, pivots, sockets, affordances and optional draft mesh.",
      "may_use": [
        "open-vocabulary detection",
        "segmentation/tracking",
        "monocular depth",
        "multi-view synthesis",
        "draft image-to-3D",
        "part graph"
      ],
      "promotion_gate": "Geometry, materials, animations and behavior suggestions pass user review."
    },
    {
      "id": "high-fidelity",
      "latency_target": "explicit queued job",
      "purpose": "Create the strongest available mesh/PBR/rig/LOD/collision result with deterministic export and full provenance.",
      "may_use": [
        "high-fidelity image-to-3D",
        "promptable segmentation",
        "PBR texture synthesis",
        "Blender processing",
        "gltf optimization",
        "convex decomposition"
      ],
      "promotion_gate": "Fresh import validation, visual comparisons and runtime performance budgets pass."
